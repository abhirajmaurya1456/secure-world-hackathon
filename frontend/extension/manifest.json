{
  "manifest_version": 3,
  "name": "PhishGuard",
  "version": "1.0.0",
  "description": "Explainable phishing URL detection using machine learning and security rules.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "webNavigation"
  ],
 "host_permissions": [
    "https://phishguard-backend-h2bo.onrender.com/*",
    "<all_urls>"
],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}